{
  "name": "mysql-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "mysql-service.flowstate.svc.cluster.local",
    "database.port": "3306",
    "database.user": "flowuser",
    "database.password": "flowpass",
    "database.server.id": "184054",
    "topic.prefix": "dbserver1",
    "database.include.list": "flowstate",
    "schema.history.internal.kafka.bootstrap.servers": "kafka-service.kafka.svc.cluster.local:9092",
    "schema.history.internal.kafka.topic": "dbhistory.flowstate",
    "schema.history.internal.kafka.topic.replication.factor": "1",
    "schema.history.internal.kafka.topic.cleanup.policy": "delete",
    "schema.history.internal.kafka.topic.retention.ms": "-1",
    "snapshot.mode": "initial",
    "include.schema.changes": "true",
    "heartbeat.interval.ms": "5000"
  }
